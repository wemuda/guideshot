{
  "$schema": "../../../packages/schema/dist/schemas/recipe.schema.json",
  "version": 1,
  "id": "showcase.framing.around",
  "title": "Related targets",
  "tags": ["showcase", "framing", "around"],
  "profile": "guide.desktop",
  "page": { "path": "/demo/showcase?scene=framing" },
  "ready": [
    { "expect": "visible", "target": "framing.panel" },
    { "expect": "visible", "target": "framing.metric" }
  ],
  "capture": {
    "frame": {
      "around": ["framing.panel", "framing.metric"],
      "padding": 28,
      "aspectRatio": "4:3",
      "fit": "expand"
    },
    "stability": "documentation"
  },
  "annotations": [
    {
      "id": "related-metric",
      "kind": "label",
      "target": "framing.metric",
      "content": "Keep the summary beside the trend",
      "placement": { "side": "bottom", "offset": 14 }
    }
  ],
  "accessibility": {
    "alt": "The revenue trend and net revenue summary framed together."
  },
  "output": { "formats": ["webp"], "width": 1600, "quality": 92 }
}
