{
  "$schema": "../../../packages/schema/dist/schemas/recipe.schema.json",
  "version": 1,
  "id": "showcase.annotation.outline",
  "title": "Outline annotation",
  "tags": ["showcase", "annotation", "outline"],
  "profile": "guide.desktop",
  "page": { "path": "/demo/showcase?scene=annotations" },
  "ready": [{ "expect": "visible", "target": "app.ready" }],
  "capture": {
    "frame": {
      "around": ["showcase.canvas"],
      "padding": 12,
      "aspectRatio": "4:3",
      "fit": "expand"
    },
    "stability": "documentation"
  },
  "annotations": [
    {
      "id": "panel-outline",
      "kind": "outline",
      "target": "showcase.panel",
      "padding": 6
    }
  ],
  "accessibility": {
    "alt": "The project health dashboard with the Milestone progress panel outlined."
  },
  "output": {
    "formats": ["webp"],
    "width": 1600,
    "height": 1200,
    "quality": 92
  }
}
