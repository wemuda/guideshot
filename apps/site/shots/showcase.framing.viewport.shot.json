{
  "$schema": "https://guideshot.dev.wemuda.com/schemas/recipe.v1.json",
  "version": 1,
  "id": "showcase.framing.viewport",
  "title": "Browser viewport",
  "tags": ["showcase", "framing", "viewport"],
  "profile": "guide.desktop",
  "page": { "path": "/demo/showcase?scene=framing" },
  "ready": [{ "expect": "visible", "target": "app.ready" }],
  "capture": {
    "frame": { "kind": "viewport" },
    "stability": "documentation"
  },
  "accessibility": {
    "alt": "The full browser viewport around the revenue health workspace."
  },
  "output": { "formats": ["webp"], "width": 1600, "quality": 92 }
}
