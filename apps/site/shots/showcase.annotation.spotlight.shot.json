{
  "$schema": "../../../packages/schema/dist/schemas/recipe.schema.json",
  "version": 1,
  "id": "showcase.annotation.spotlight",
  "title": "Spotlight annotation",
  "tags": ["showcase", "annotation", "spotlight"],
  "profile": "guide.desktop",
  "page": { "path": "/demo/showcase?scene=annotations" },
  "ready": [{ "expect": "visible", "target": "app.ready" }],
  "capture": {
    "frame": {
      "around": ["showcase.canvas"],
      "padding": 12,
      "aspectRatio": "4:3",
      "fit": "expand"
    },
    "stability": "documentation"
  },
  "annotations": [
    {
      "id": "metric-spotlight",
      "kind": "spotlight",
      "target": "showcase.metric",
      "padding": 8
    }
  ],
  "accessibility": {
    "alt": "The project health dashboard with the Active users metric spotlighted."
  },
  "output": {
    "formats": ["webp"],
    "width": 1600,
    "height": 1200,
    "quality": 92
  }
}
