{
  "$schema": "../../../packages/schema/dist/schemas/recipe.schema.json",
  "version": 1,
  "id": "showcase.annotation.marker",
  "title": "Marker annotation",
  "tags": ["showcase", "annotation", "marker"],
  "profile": "guide.desktop",
  "page": { "path": "/demo/showcase?scene=annotations" },
  "ready": [{ "expect": "visible", "target": "app.ready" }],
  "capture": {
    "frame": {
      "around": ["showcase.canvas"],
      "padding": 12,
      "aspectRatio": "4:3",
      "fit": "expand"
    },
    "stability": "documentation"
  },
  "annotations": [
    {
      "id": "status-marker",
      "kind": "marker",
      "target": "showcase.status",
      "content": "1",
      "placement": { "side": "right", "offset": 10 }
    }
  ],
  "accessibility": {
    "alt": "The project health dashboard with a numbered marker beside the On track status."
  },
  "output": {
    "formats": ["webp"],
    "width": 1600,
    "height": 1200,
    "quality": 92
  }
}
