{
  "name": "@guideshot/cli",
  "version": "0.1.2",
  "description": "Command-line and programmatic orchestration for GuideShot.",
  "license": "MIT",
  "keywords": [
    "guideshot",
    "cli",
    "screenshots",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wemuda/guideshot.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/wemuda/guideshot#readme",
  "bugs": {
    "url": "https://github.com/wemuda/guideshot/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "guideshot": "./bin/guideshot.mjs"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "guideshot": "./dist/bin.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --sourcemap --clean",
    "prepack": "pnpm run build && test -f dist/index.js && test -f dist/index.d.ts && test -x dist/bin.js",
    "test": "vitest run --root ../.. packages/cli/test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guideshot/core": "workspace:*",
    "execa": "^9.6.1",
    "image-size": "^2.0.2",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.5.0"
  }
}
