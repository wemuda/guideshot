{
  "name": "@guideshot/renderer",
  "version": "0.1.4",
  "description": "Deterministic offline annotation renderer for GuideShot scenes.",
  "license": "MIT",
  "keywords": [
    "guideshot",
    "screenshots",
    "annotations",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wemuda/guideshot.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/wemuda/guideshot#readme",
  "bugs": {
    "url": "https://github.com/wemuda/guideshot/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "prepack": "pnpm run build && test -f dist/index.js && test -f dist/index.d.ts",
    "test": "vitest run --root ../.. packages/renderer/test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@guideshot/core": "workspace:*",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
