{
  "name": "@guideshot/core",
  "version": "0.2.0",
  "description": "Portable compiler and contracts for GuideShot.",
  "license": "MIT",
  "keywords": [
    "guideshot",
    "screenshots",
    "documentation",
    "visual-testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wemuda/guideshot.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/wemuda/guideshot#readme",
  "bugs": {
    "url": "https://github.com/wemuda/guideshot/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "pnpm run build && test -f dist/index.js && test -f dist/index.d.ts",
    "test": "vitest run --root ../.. packages/core/test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guideshot/schema": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
